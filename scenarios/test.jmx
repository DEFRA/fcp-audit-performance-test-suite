<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>

    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="fcp-audit-performance-test-suite Performance Tests" enabled="true">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>

    <hashTree>

      <!-- Ingestion test (setUp thread group): runs to completion before the API read load starts -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Ingestion test" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <!-- Get Microsoft Entra Token -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Get token if auth enabled" enabled="true">
          <stringProp name="IfController.condition">${__groovy('true'.equalsIgnoreCase(props.get('auth_enabled')))}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
        </IfController>
        <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Setup Proxy if Present" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Set proxy configuration if HTTP_PROXY is provided
String httpProxy = props.get(&quot;http_proxy&quot;)
if (httpProxy != null &amp;&amp; !httpProxy.isEmpty()) {
    // Parse proxy URL to extract host and port
    def matcher = (httpProxy =~ /^https?:\/\/([^:\/]+)(?::(\d+))?/)
    if (matcher.find()) {
        String proxyHost = matcher.group(1)
        String proxyPort = matcher.group(2) ?: &quot;80&quot;
        sampler.setProperty(&quot;HTTPSampler.proxyHost&quot;, proxyHost)
        sampler.setProperty(&quot;HTTPSampler.proxyPort&quot;, proxyPort)
        log.info(&quot;Using proxy: &quot; + proxyHost + &quot;:&quot; + proxyPort)
    }
}</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get Entra Token" enabled="true">
          <stringProp name="HTTPSampler.domain">login.microsoftonline.com</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/${__P(tenant_id)}/oauth2/v2.0/token</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="client_id" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${__P(client_id)}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">client_id</stringProp>
              </elementProp>
              <elementProp name="client_secret" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${__P(client_secret)}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">client_secret</stringProp>
              </elementProp>
              <elementProp name="scope" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${__P(scope)}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">scope</stringProp>
              </elementProp>
              <elementProp name="grant_type" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">client_credentials</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">grant_type</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/x-www-form-urlencoded</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract Access Token" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">access_token</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Set Token as Property" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Convert variable to property so it's available across thread groups
props.put(&quot;access_token&quot;, vars.get(&quot;access_token&quot;))</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        </hashTree>

        <!-- Measure how quickly fcp-audit ingests audit messages: publish a known volume through the
             publisher stub, then time how long until it is all readable from the audit API.
             Skipped when -Jdisable_events=true. -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Measure audit message ingestion" enabled="true">
          <stringProp name="IfController.condition">${__groovy(!'true'.equalsIgnoreCase(props.get('disable_events')))}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
        </IfController>
        <hashTree>
          <!-- Audit total before publishing -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Audit summary (baseline)" enabled="true">
            <stringProp name="HTTPSampler.domain">${__P(domain, fcp-audit.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
            <stringProp name="HTTPSampler.protocol">${__P(protocol, https)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(port, 3004)}</stringProp>
            <stringProp name="HTTPSampler.path">/api/v1/audit/summary</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization Header" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${__P(access_token)}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Audit summary response assertion" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Audit summary should return 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Calculate expected total" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

// fcp-audit publishes an audit event (application 'Audit Service') for each of its own API calls,
// including these summary requests and the read load, so leave those out of the count
long countPublishedEvents(def result) {
    if (result.getResponseCode() != '200') {
        return -1L
    }
    try {
        def applications = new JsonSlurper().parseText(result.getResponseDataAsString()).data.summary.applications
        return applications.findAll { it.application != 'Audit Service' }.sum(0L) { it.total as long }
    } catch (Exception e) {
        log.warn('Unable to read audit summary: ' + e.message)
        return -1L
    }
}

// Work out the audit total that marks the end of ingestion for the messages about to be published
long baseline = countPublishedEvents(prev)
vars.put('baseline_total', String.valueOf(baseline))

long repetitions = (props.get('ingest_repetitions') ?: '5000') as long
long perRepetition = (props.get('ingest_audit_events_per_repetition') ?: '2') as long
long expectedEvents = repetitions * perRepetition

// Split the repetitions across several simulate requests. The stub publishes each request in its own
// background job, so the jobs run side by side and publish faster than a single request can
long publishers = Math.max(1L, Math.min((props.get('ingest_publishers') ?: '10') as long, repetitions))
vars.put('publish_requests', String.valueOf(publishers))
vars.put('publish_base_repetitions', String.valueOf(repetitions.intdiv(publishers)))
vars.put('publish_extra_repetitions', String.valueOf(repetitions % publishers))
vars.put('publish_index', '0')

vars.put('expected_events', String.valueOf(expectedEvents))
vars.put('ingest_done', 'false')
vars.put('ingest_error', '')

if (baseline &lt; 0) {
    // Without a baseline there is nothing to measure against, but still publish so the read load has data
    vars.put('ingest_done', 'true')
    vars.put('ingest_error', 'Could not read baseline audit total (HTTP ' + prev.getResponseCode() + ')')
} else {
    vars.put('expected_total', String.valueOf(baseline + expectedEvents))
}

log.info('Publishing ' + repetitions + ' repetitions across ' + publishers + ' simulate requests, expecting ' + expectedEvents + ' audit events on top of baseline ' + baseline)</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>

          <!-- Timed from sending the first simulate request until the expected events are readable from the audit API -->
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Ingest audit messages" enabled="true">
            <boolProp name="TransactionController.includeTimers">true</boolProp>
            <boolProp name="TransactionController.parent">false</boolProp>
          </TransactionController>
          <hashTree>

            <!-- One simulate request per publisher. Each returns 202 straight away, so they are all sent within
                 moments of each other and the stub publishes them in parallel -->
            <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Start publishers" enabled="true">
              <stringProp name="LoopController.loops">${publish_requests}</stringProp>
              <boolProp name="LoopController.continue_forever">true</boolProp>
            </LoopController>
            <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Publish audit messages" enabled="true">
              <stringProp name="HTTPSampler.domain">${__P(event_domain, fcp-audit-publisher-stub.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
              <stringProp name="HTTPSampler.protocol">${__P(protocol, https)}</stringProp>
              <stringProp name="HTTPSampler.port">${__P(event_port, 3005)}</stringProp>
              <stringProp name="HTTPSampler.path">/api/v1/simulate/audit?repetitions=${publish_repetitions}</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set publisher repetitions" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// Share the repetitions evenly, giving one extra to the first few requests when they don't divide exactly
int index = vars.get('publish_index') as int
long repetitions = (vars.get('publish_base_repetitions') as long) + (index &lt; (vars.get('publish_extra_repetitions') as int) ? 1 : 0)
vars.put('publish_repetitions', String.valueOf(repetitions))
vars.put('publish_index', String.valueOf(index + 1))</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Publish response assertion" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="49588">202</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">Simulate Messages API should return 202</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Record ingestion start" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// Ingestion is timed from when the first simulate request was sent
if (!vars.get('ingest_start')) {
    vars.put('ingest_start', String.valueOf(prev.getStartTime()))
}

// The stub responds 202 and publishes in the background, so anything else means no events are coming
if (prev.getResponseCode() != '202' &amp;&amp; vars.get('ingest_done') != 'true') {
    vars.put('ingest_done', 'true')
    vars.put('ingest_error', 'Simulate request failed (HTTP ' + prev.getResponseCode() + ')')
}</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
            </hashTree>

            <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Wait for messages to be ingested" enabled="true">
              <stringProp name="WhileController.condition">${__groovy(vars.get('ingest_done') != 'true')}</stringProp>
            </WhileController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Audit summary (poll)" enabled="true">
                <stringProp name="HTTPSampler.domain">${__P(domain, fcp-audit.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
                <stringProp name="HTTPSampler.protocol">${__P(protocol, https)}</stringProp>
                <stringProp name="HTTPSampler.port">${__P(port, 3004)}</stringProp>
                <stringProp name="HTTPSampler.path">/api/v1/audit/summary</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
                  <collectionProp name="Arguments.arguments"/>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>
                <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll interval" enabled="true">
                  <stringProp name="ConstantTimer.delay">${__P(ingest_poll_interval_ms,2000)}</stringProp>
                </ConstantTimer>
                <hashTree/>
                <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization Header" enabled="true">
                  <collectionProp name="HeaderManager.headers">
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">Authorization</stringProp>
                      <stringProp name="Header.value">Bearer ${__P(access_token)}</stringProp>
                    </elementProp>
                  </collectionProp>
                </HeaderManager>
                <hashTree/>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Audit summary response assertion" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="49586">200</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.custom_message">Audit summary should return 200</stringProp>
                  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">2</intProp>
                </ResponseAssertion>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Check ingestion progress" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper

// fcp-audit publishes an audit event (application 'Audit Service') for each of its own API calls,
// including these summary requests and the read load, so leave those out of the count
long countPublishedEvents(def result) {
    if (result.getResponseCode() != '200') {
        return -1L
    }
    try {
        def applications = new JsonSlurper().parseText(result.getResponseDataAsString()).data.summary.applications
        return applications.findAll { it.application != 'Audit Service' }.sum(0L) { it.total as long }
    } catch (Exception e) {
        log.warn('Unable to read audit summary: ' + e.message)
        return -1L
    }
}

long current = countPublishedEvents(prev)
vars.put('current_total', String.valueOf(current))
long expected = vars.get('expected_total') as long
long start = vars.get('ingest_start') as long
long timeoutMs = ((props.get('ingest_timeout_seconds') ?: '600') as long) * 1000
long elapsedMs = prev.getEndTime() - start

if (current &gt;= expected) {
    vars.put('ingest_done', 'true')
    vars.put('ingest_end', String.valueOf(prev.getEndTime()))
} else if (elapsedMs &gt;= timeoutMs) {
    vars.put('ingest_done', 'true')
    vars.put('ingest_error', 'Timed out after ' + (elapsedMs / 1000) + 's waiting for ' + expected + ' audit events (last total ' + current + ')')
}</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
              </hashTree>
            </hashTree>

            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Verify audit messages ingested" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Report the result of the ingestion phase. This sampler fails if ingestion did not complete.
String error = vars.get('ingest_error')

if (error) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('500')
    SampleResult.setResponseMessage(error)
    log.error('Ingestion test failed: ' + error)
    return error
}

long events = (vars.get('current_total') as long) - (vars.get('baseline_total') as long)
long durationMs = (vars.get('ingest_end') as long) - (vars.get('ingest_start') as long)
double rate = durationMs &gt; 0 ? events * 1000d / durationMs : 0d
String pollMs = props.get('ingest_poll_interval_ms') ?: '2000'
String summary = String.format('Ingested %d audit events in %.1fs (%.1f events/s, %s publishers, accurate to the %sms poll interval)', events, durationMs / 1000d, rate, vars.get('publish_requests'), pollMs)

SampleResult.setResponseCode('200')
SampleResult.setResponseMessage(summary)
log.info(summary)
return summary</stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>

      <!-- API read load -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="API read load">
        <stringProp name="ThreadGroup.num_threads">${__P(api_threads,20)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(api_ramp_up_seconds,30)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(api_duration_seconds,630)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">-1</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- Health probe -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Health probe" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(domain, fcp-audit.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(protocol, https)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port, 3004)}</stringProp>
          <stringProp name="HTTPSampler.path">/health</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Start page response assertion" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Health probe should return 200</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- Messages API -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Messages API" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(domain, fcp-audit.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(protocol, https)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port, 3004)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/audit</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization Header" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${__P(access_token)}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Messages API response assertion" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Audit API should return 200</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

      </hashTree>

      <!-- Listener -->
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
